<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.123yogin.oci-assume</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/oci-assume</string>
		<string>refresh</string>
		<string>--all</string>
		<string>--background</string>
	</array>
	<key>StartInterval</key>
	<integer>1800</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin</string>
		<key>OCI_ASSUME_OCI_BIN</key>
		<string>/opt/oci/bin/oci</string>
		<key>OCI_ASSUME_STATE_DIR</key>
		<string>/home/user/state</string>
		<key>OCI_CLI_CONFIG_FILE</key>
		<string>/home/user/.oci/config</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/home/user/Library/Logs/oci-assume.log</string>
	<key>StandardErrorPath</key>
	<string>/home/user/Library/Logs/oci-assume.log</string>
</dict>
</plist>
